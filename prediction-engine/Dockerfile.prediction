# =============================================================================
# Speed WMS - Python FastAPI Prediction Engine Dockerfile
# Python 3.11 / FastAPI 0.115 / Uvicorn
# 使用单阶段构建（Python 无需编译产物，但仍进行缓存优化）
# =============================================================================

# 使用官方 Python slim 镜像（Debian base，兼容 pymysql 等原生依赖）
# slim 版本相比 full 版本体积减少约 60%，同时保留运行所需的系统库
FROM python:3.11-slim AS runtime

# 【安全性】创建最小权限的应用专用用户
RUN groupadd -r appgroup && useradd -r -g appgroup appuser

# 设置工作目录
WORKDIR /app

# 【Python 最佳实践】设置环境变量
# PYTHONDONTWRITEBYTECODE：禁止生成 .pyc 缓存文件，减小镜像体积
# PYTHONUNBUFFERED：禁用输出缓冲，确保日志实时输出到 Docker 日志驱动
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# 【缓存优化】优先复制依赖文件，单独安装依赖。
# 仅在 requirements.txt 变更时才重新执行 pip install，充分利用构建缓存。
COPY requirements.txt .

# 安装 Python 依赖，--no-cache-dir 避免在镜像中残留 pip 缓存文件
RUN pip install --no-cache-dir -r requirements.txt

# 复制应用源码（放在依赖安装之后，保护缓存层）
COPY config.py database.py models.py predictor.py main.py ./

# 将文件所有权移交给 appuser
RUN chown -R appuser:appgroup /app

# 切换到非 root 用户运行
USER appuser

# 声明服务暴露的端口（FastAPI/Uvicorn 默认 8000）
EXPOSE 8000

# 启动 Uvicorn ASGI 服务器
# --host 0.0.0.0：监听所有网络接口，允许容器外部访问
# --port 8000：监听端口
# --workers 2：生产环境建议 workers = CPU核数 * 2 + 1
# --no-access-log：日志由外部日志系统（如 ELK）处理时可关闭访问日志
CMD ["uvicorn", "main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "2"]
