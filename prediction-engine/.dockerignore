# =============================================================================
# Speed WMS - Prediction Engine .dockerignore
# 用于 prediction-engine/Dockerfile.prediction（Python FastAPI）
# =============================================================================

# ────────── Python 虚拟环境（容器内使用全局 pip 安装）──────────
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class

# ────────── Python 构建产物 ──────────
*.egg-info/
dist/
build/
.eggs/

# ────────── 测试和覆盖率 ──────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ────────── IDE 配置 ──────────
.vscode/
.idea/

# ────────── 日志 ──────────
*.log

# ────────── 操作系统临时文件 ──────────
.DS_Store
Thumbs.db

# ────────── 环境变量（敏感信息，通过 -e 或 --env-file 注入）──────────
.env
.env.*

# ────────── 文档 ──────────
*.md

# ────────── Docker 文件本身 ──────────
Dockerfile*
.dockerignore
