# =============================================================================
# Speed WMS - 环境变量模板文件
# 使用方法：
#   1. 将此文件复制为 .env.prod：  copy .env.example .env.prod
#   2. 填入实际的密码和密钥
#   3. 运行时指定：  docker compose --env-file .env.prod up -d
#
# ⚠️  警告：.env.prod 文件不得提交到 Git（已在 .gitignore 中排除）
# =============================================================================

# ────────── PostgreSQL ──────────
POSTGRES_USER=wms_user
POSTGRES_PASSWORD=change_this_db_password_in_prod

# ────────── Redis ──────────
REDIS_PASSWORD=change_this_redis_password_in_prod

# ────────── JWT 签名密钥（生产环境必须使用强随机字符串，建议 64 字符以上）──────────
# 可使用以下命令生成：
#   PowerShell:  [System.Convert]::ToBase64String((1..64 | %{ [byte](Get-Random -Max 256) }))
#   Linux/Mac:   openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_KEY_AT_LEAST_64_CHARS_LONG
