# =============================================================================
# Speed WMS - 环境变量模板文件
# 使用方法：
#   1. 复制此文件为 .env.local（本地开发）：  copy .env.example .env.local
#   2. 复制此文件为 .env.prod（生产部署）：   copy .env.example .env.prod
#   3. 填入实际的密码和密钥
#   4. 生产运行：  docker compose --env-file .env.prod up -d
#   5. 本地开发：  在 IDE 的运行配置中加载 .env.local，或使用 direnv
#
# ⚠️  警告：.env.local / .env.prod 文件严禁提交到 Git（已在 .gitignore 中排除）
#           此 .env.example 文件本身不含任何真实密钥，可以安全提交。
# =============================================================================

# ──────────── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_USER=wms_user
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_DB_PASSWORD

# ──────────── Redis ─────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_THIS_STRONG_REDIS_PASSWORD

# ──────────── JWT 签名密钥 ──────────────────────────────────────────────────
# [REQUIRED] 生产环境必须使用强随机字符串（64 字符以上）
# 生成命令：
#   Linux/Mac:   openssl rand -base64 64
#   PowerShell:  [System.Convert]::ToBase64String((1..64 | %{ [byte](Get-Random -Max 256) }))
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_KEY_AT_LEAST_64_CHARS_LONG

# ──────────── Spring Boot 数据源（覆盖 application.yml 默认值）──────────────
# 本地开发时如果 PostgreSQL 不在容器中，按需设置以下变量：
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/wms_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=CHANGE_THIS_STRONG_DB_PASSWORD

# ──────────── Spring Profile ─────────────────────────────────────────────────
# 本地开发：dev（不改）  生产部署：prod
SPRING_PROFILES_ACTIVE=dev

# ──────────── AI 预测引擎（可选）────────────────────────────────────────────
# ENGINE_PORT=8000
