# =============================================================================
# Speed WMS - Frontend .dockerignore
# 用于 wms-frontend/Dockerfile.frontend（React/Vite 前端）
# =============================================================================

# ────────── Node 模块（容器内重新安装）──────────
node_modules/

# ────────── Vite 构建输出（容器内重新构建）──────────
dist/
.vite/

# ────────── 日志文件 ──────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ────────── IDE 配置 ──────────
.vscode/
.idea/

# ────────── 操作系统临时文件 ──────────
.DS_Store
Thumbs.db

# ────────── 测试和文档 ──────────
*.md
coverage/
.nyc_output/

# ────────── 环境变量（敏感信息，不进入镜像）──────────
.env
.env.local
.env.*.local

# ────────── Docker 文件本身 ──────────
Dockerfile*
nginx.conf
.dockerignore
