# =============================================================================
# Speed WMS - React / Vite Frontend Dockerfile
# Node.js 20 LTS (Alpine) → Nginx Alpine
# 多阶段构建 (Multi-stage Build)
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 【阶段1：构建阶段 (Builder Stage)】
# 使用 Node.js Alpine 镜像执行 npm 依赖安装和 Vite 打包
# ─────────────────────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# 【缓存优化】优先复制包管理文件，利用 Docker 层缓存。
# 仅在 package.json 或 package-lock.json 变更时才重新安装依赖。
COPY package.json package-lock.json ./

# 使用 npm ci（clean install）确保依赖版本与 lock 文件严格一致，适合 CI/CD
RUN npm ci --frozen-lockfile

# 复制所有前端源码
COPY . .

# 执行生产构建（输出至 /app/dist）
RUN npm run build

# ─────────────────────────────────────────────────────────────────────────────
# 【阶段2：运行阶段 (Runtime Stage)】
# 使用极轻量的 Nginx Alpine 作为静态文件服务器（约 10MB）
# Node.js 运行时完全不进入最终镜像
# ─────────────────────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

# 【安全性】删除 Nginx 默认配置，替换为自定义配置
RUN rm /etc/nginx/conf.d/default.conf

# 复制自定义 Nginx 配置（处理 SPA 路由和 API 反向代理）
COPY nginx.conf /etc/nginx/conf.d/wms.conf

# 从构建阶段复制 Vite 打包输出的静态文件
COPY --from=builder /app/dist /usr/share/nginx/html

# 【安全性】Nginx 以非 root 用户运行（nginx 用户，Alpine 内置）
# nginx:alpine 镜像默认 worker 进程以 nginx 用户身份运行

# 声明 HTTP 服务端口
EXPOSE 80

# 前台运行 Nginx（daemon off 确保容器不退出）
CMD ["nginx", "-g", "daemon off;"]
